# Supabase browser + Edge Function configuration. Only the URL and publishable
# key are embedded in the Vite client. The secret key remains server-only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Optional direct Postgres URL for psql migrations and bulk loaders.
DATABASE_URL_DIRECT=

# Source credentials. Leave blank until the matching source is enabled.
DATA_GOV_IN_API_KEY=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
NASA_EARTHDATA_TOKEN=

# Raw photos, rasters, NetCDF files, and source snapshots live in object storage,
# not inside Postgres. Use an S3-compatible bucket with private-by-default access.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
